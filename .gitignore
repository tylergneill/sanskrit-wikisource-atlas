MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/

# PyCharm
.idea/

# macOS
.DS_Store

# Playwright (used ad hoc for visual verification of docs2/ changes -- this
# repo has no build step/dependencies of its own, so these aren't checked in;
# reinstall with `npm install -D playwright` when needed)
node_modules/
package.json
package-lock.json

# scrape.py disk-backed API response cache (regenerable; see API_CACHE_DIR)
.api_cache/

# pipeline/fetch.py downloaded MediaWiki dump exports (regenerable, large)
dump/

# pipeline/process.py output, regenerated by `make process` -- not yet the
# real deploy artifact (docs2/ is a preview frontend, see docs/ for that)
docs2/data/tree2.json

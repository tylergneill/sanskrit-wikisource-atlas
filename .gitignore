# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/

# PyCharm
.idea/

# macOS
.DS_Store

# Playwright (used ad hoc for visual verification of docs/ changes -- this
# repo has no build step/dependencies of its own, so these aren't checked in;
# reinstall with `npm install -D playwright` when needed)
node_modules/
package.json
package-lock.json

# pipeline/fetch.py downloaded MediaWiki dump exports (regenerable, large)
dump/

# leftover disk-backed API response cache from the retired v1 scraper
# (scrape.py, deleted) -- dead weight, safe to remove from disk entirely
.api_cache/

# pipeline/extract_fulltext.py output: the corpus text itself, hundreds of MB,
# and a pure function of the dump plus the extractor. This repo hosts no text.
# Leading slash so docs/data/ stays tracked.
/data/
